// Sends the short domain to the landing page: `cd apps/landing/redirect && npx wrangler deploy`.
{
  "name": "standard-artifacts-redirect",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "stdartifacts.com", "custom_domain": true },
    { "pattern": "www.stdartifacts.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
