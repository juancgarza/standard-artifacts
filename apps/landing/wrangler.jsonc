// The landing page as a static-assets Worker: `pnpm --filter @standard-artifacts/landing deploy`.
// The custom domain (standardartifacts.com) is attached in the Cloudflare dashboard once its zone is on Cloudflare.
{
  "name": "standard-artifacts-landing",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "workers_dev": true,
  "preview_urls": false
}
