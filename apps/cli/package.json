{
  "name": "stdartifacts",
  "version": "0.1.1",
  "description": "Command-line client and stdio MCP server for Standard Artifacts: shared tables, boards, docs and issue trackers.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/juancgarza/standard-artifacts.git", "directory": "apps/cli" },
  "homepage": "https://standardartifacts.com",
  "type": "module",
  "bin": {
    "stdartifacts": "./dist/stdartifacts.mjs"
  },
  "files": ["dist/stdartifacts.mjs", "LICENSE", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/stdartifacts.mjs --log-level=warning --external:playwright-core --external:@anthropic-ai/claude-agent-sdk --external:@standard-artifacts/server --banner:js=\"#!/usr/bin/env node\nimport { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@standard-artifacts/server": "workspace:^"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "playwright-core": "^1.56.1"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": { "optional": true },
    "playwright-core": { "optional": true }
  },
  "devDependencies": {
    "@standard-artifacts/client": "workspace:*",
    "@standard-artifacts/mcp": "workspace:*",
    "@standard-artifacts/protocol": "workspace:*",
    "@effect/platform-node": "~4.0.7",
    "effect": "~4.0.7",
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "playwright-core": "1.56.1",
    "@types/node": "^24",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  }
}
