{
  "name": "@standard-artifacts/desktop",
  "productName": "Standard Artifacts",
  "version": "0.1.0",
  "description": "Desktop app for Standard Artifacts",
  "author": "Standard Artifacts",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --loader:.html=text --outdir=dist --out-extension:.js=.cjs --log-level=warning",
    "dev": "pnpm build && electron .",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir -c.mac.identity=-",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@standard-artifacts/protocol": "workspace:*",
    "@types/node": "^24",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  }
}
